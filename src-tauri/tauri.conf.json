{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wealth VN",
  "version": "0.1.6",
  "identifier": "vn.wealth.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wealth VN - Quản lý tài sản",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "splash",
        "title": "Wealth VN",
        "url": "splash.html",
        "width": 420,
        "height": 320,
        "decorations": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/wealth-backend"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/VuDHA/FinProj/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGNzNCM0ZENEMzODI4NDcKUldSSEtEaE0vYk56WHlsdDJvQjFsbXBFUDdob3lxeVlzbjI3TUE1U3IvWmpvcXJPWDdtVnlWcEUK",
      "dialog": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
