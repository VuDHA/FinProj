DATABASE_URL=sqlite:///./data/wealth.db
SCHEDULER_HOUR=15
SCHEDULER_MINUTE=35

# AI provider: "gemini" | "ollama". Gemini is primary; Ollama is fallback.
AI_PROVIDER=ollama
AI_BATCH_SIZE=8
AI_TIMEOUT_SECONDS=30

# Google Gemini API (primary AI provider). Get a key at aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768

# News relevance threshold. Articles with score >= this value are saved.
NEWS_RELEVANCE_THRESHOLD=0.6

# News LLM batch size (legacy Ollama setting). Use AI_BATCH_SIZE for Gemini.
NEWS_LLM_BATCH_SIZE=1

# Local LLM for tag generation (optional). Set OLLAMA_ENABLED=true to enable.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=30
OLLAMA_MAX_TAGS=5

# CPU tuning for the Ollama server. 0 = auto-detect threads. Keep alive keeps the model loaded between calls.
OLLAMA_NUM_THREADS=0
OLLAMA_KEEP_ALIVE=15m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# Global AI queue: only one Ollama call at a time (generate or embedding).
OLLAMA_AI_QUEUE_TIMEOUT_SECONDS=60

# Embeddings for RAG (optional). Set OLLAMA_EMBEDDING_ENABLED=true and pull nomic-embed-text.
OLLAMA_EMBEDDING_ENABLED=false
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSION=768
